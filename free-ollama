#!/bin/bash
#
# Pet the feral llama
#
#   \\         
#    l'> Bahhhhh
#    ll       
#    llama~  
#    || ||  
#    '' ''
#
# Example abusage:
#
# free-ollama gemma3:latest {0..10}
#
# It's a stack based system with the syntax
# [model-name [index ... ]]*
# You can omit the index to see all of them.
#
# The column output is space delimetered so you can 
#
# $ free-ollama model1 model2 | sort -rn | cut -d ' ' -f 1-2 | xargs -d '\n' -I {} redis-cli rpush server-pool "{}"
#
# And now you have a server pool. You can even "test" it.
# 
# $ free-ollama --test model1
#
# Try instrumenting it with llcat, then maybe xpanes
#
# Don't know what to choose?
# Run it without arguments, you'll get a frequency distribution.
#

_cache="$HOME/.cache/free-ollama"
[[ -d "$_cache" ]] || mkdir -p "$_cache"

_db="$_cache/free-ollama.json"
_bad="$_cache/bad-hosts.txt"
_host=
_mas=
_timeout=90

cache() {
    if ! command -v curl > /dev/null 2>&1; then
        for i in {5..2}; do
            printf "\r\033[K🎯%*s🥌🧹" $i ''
            sleep 0.5;
        done
        printf "\r\033[K🎯🥌 🧹" 
        sleep 0.5;
        printf "\r\033[K🥌  🧹\n" 
        echo "This is the closest I can get to curling on this system. Go install curl."
        exit
    fi
    if [[ -n "$1" ]] || [[ ! -s "$_db" ]] || [[ -n "$(find "$_db" -mmin +1440)" ]]; then
        echo "Updating cache..." > /dev/stderr
        curl -L 'https://awesome-ollama-server.vercel.app/data.json' > "${_db}-vercel.tmp"
        curl -L 'https://raw.githubusercontent.com/PuddinCat/OllamaSpider/refs/heads/main/url_models.json' > "${_db}-spider.tmp"
        curl -L 'https://raw.githubusercontent.com/happyshua/ollamalist/refs/heads/main/output_with_models.csv' > "${_db}-happyshua.tmp"
        {
          echo "server,models";
          cat "${_db}-happyshua.tmp"
        } | python3 -c "
import csv, json, sys
n = list(csv.DictReader(sys.stdin))
host_map = {}

with open('${_db}-vercel.tmp', 'r') as f:
  for row in json.loads(f.read()):
    host_map[row.get('server')] = row

for r in n:
  ip = r.get('server')
  models = [m.strip() for m in r['models'].split(',')]
  if ip not in host_map:
    host_map[ip] = {'tps': 0, 'models': [], 'server': ip}

  host_map[ip]['models'] += models

with open('${_db}-spider.tmp', 'r') as f:
  for row in json.loads(f.read()):
    ip = row.get('url')
    models = [ n.get('name') for n in row.get('models') ]
    if ip not in host_map:
      host_map[ip] = {'tps': 0, 'models': [], 'server': ip}

    host_map[ip]['models'] += models

for k,v in host_map.items():
  v['models'] = list(set(v['models']))

print(json.dumps(list(host_map.values())))" > "$_db"
    fi
}

process_stack() {
    local out=' "\(.tps | floor) \(.server) \(.models 
            | map(select(contains("'$model'"))) 
            | join(" ")) "' 
    [[ -z "$model" ]] && return
    [[ "$model" =~ cloud ]] && nocloud= || nocloud='and (.models | all(contains(":cloud") | not))'

    if [[ -n "$_host" ]]; then 
        ## MAS format https://day50.dev/mas.html
        if [[ -n "$_mas" ]]; then
            out='"\(.server)#m='$model'"'
        else
            out='"\(.server)"'
        fi
    fi

    jq -r 'map(
       select( .models 
               and (.models | contains(["'$model'"]))
               and (.models | all(contains(":cloud") | not))
               '"$nocloud"'
           )
       ) 
       | sort_by(.tps) 
       | .['$(IFS=,; echo "${index[*]}")'] 
       | '"$out" "$_db"

   index=()
}

curly() {
    curl -d '{"model":"'$4'","messages":[{"role":"user","content":"'$5'\n"}]}' $2 2>&1
}

tester() {
    pet=-1
    skip=${1:-0}
    touch "$_bad"
    if [[ -n "$dotest" ]]; then
        tester=llcat
        if ! command -v llcat > /dev/null 2>&1; then
            if command -v uv > /dev/null 2>&1; then
                tester="uvx llcat"
            elif ! command curl > /dev/null 2>&1; then
                tester=curly
            else
                echo "You need llcat or uv or curl to test."
                echo
                echo "First of all, what the fuck is wrong with you? Is this how you live?"
                echo
                echo "Second, do one of these:"
                echo
                echo " * pipx install llcat"
                echo " * uv tool install llcat"
                echo " * pip install llcat (probably won't work but you do you)"
                exit 1
            fi
        fi

        tac | grep -vFf "$_bad" | while read tps host model; do
            if [[ -n "$dosmoke" ]]; then
              echo "$host $($tester --timeout $_timeout -u $host -m | tr '\n' ' ')"
              echo "  ->" $(curl -s $host/api/ps | jq -r '.models[].name')
              continue
            fi

            (( pet ++ ))
            (( pet < skip )) && continue 

            # The < /dev/null is to avoid llcat from slurping up the stdin
            start_time=$(date +%s.%N)
            model=${model%% *}

            running="$(curl -s $host/api/ps | jq -r '.models[].name' | tr '\n' ' ' | tr -d ' ')"
            if [[ -n "$running" && "$running" != "$model" ]]; then
                echo " $host" > /dev/stderr
                echo "    ╰─ Running: <$running> (wanted <$model>)" > /dev/stderr
                continue
            else
                timeout "$_timeout"s $tester --timeout "$_timeout" -u $host -m $model "respond with the single word 'test'" </dev/null > "$_cache/free-ollama.test" 2>&1
                end_time=$(date +%s.%N)
                timing=$( echo "$end_time - $start_time" | bc )
            fi

            if [[ -s "$_cache/free-ollama.test" ]] && ! grep -iE '(fail|error)' "$_cache/free-ollama.test" > /dev/null; then 

                if [[ -n "$1" ]]; then
                    if [[ "$info" == 1 ]]; then 
                        echo " Looking under the hood!" > /dev/stderr
                        if [[ $tester != 'curly' ]]; then
                            $tester --timeout "$_timeout" -u $host -m $model --info </dev/null | jq . > /dev/stderr
                            echo > /dev/stderr
                        fi
                    fi
                    echo "$host"
                    return
                fi

                printf "%s %s#m=%s\n" ${timing:0:4} $host $model
               
            else 
                echo " 🐡 Not friendly! $host#m=$model" > /dev/stderr
                echo "    ╰─ " $(jq -r .data.response.payload.error.message "$_cache/free-ollama.test")  > /dev/stderr
                [[ -n "$host" && -n "$model" ]] && echo "$host $model" >> "$_bad"
            fi
        done
    else
        cat
    fi
}

proxy() {
    local start=11434
    local pet=0
    if [[ ! "$1" =~ /http/ ]]; then
        model="$1"
        dotest=1
    else
        host="$1"
    fi

    while true; do
        if [[ "$dotest" == 1 ]]; then
            echo " 👀 to pet a $model"
            host=$(process_stack | tester $pet)
            if [[ -z "$host" ]]; then
                echo -e " 🌵 There doesn't seem to be any good hosts!\n    Check $_bad"
                exit 1
            fi
        fi
        while true; do
            echo " $host -> 127.0.0.1:$start"

            if command -v socat > /dev/null 2>&1; then
                socat TCP-LISTEN:$start,fork,reuseaddr TCP:${host#*://} 
            else
                echo "You need socat for the proxy."
            fi

            [[ $? != 1 ]] && break
            echo " \_ Woops :$start is in use"
            (( start++ ))
        done
        echo
        read -p " Press Enter for more 🦙. Ctrl+C to leave the park..."
        (( pet++ ))
    done
    exit
}

cache
if [[ -z "$1" ]]; then
    jq -r 'map(.models[]) | group_by(.) | map("\(length) \(.[0])") | .[]' "$_db" | sort -n
else
    declare -a index
    model=
    while [ $# -gt 0 ]; do
        case $1 in
            --exec)
              shift
              export OLLAMA_HOST="${@: -1}"
              ollama ${@:1:$#-1} 
              exit 0
              ;;
            --timeout)
              shift
              _timeout=$1 ;;
            --host) _host=1 ;;
            --mas)  _host=1 _mas=1 ;;
            --info) info=1 ;;
            --proxy) proxy $2 ;;
            --update|--refresh) 
              truncate -s 0 "$_bad"
              cache 1; 
              echo "Ahh! How refreshing";;
            --help) $(command -v batcat || echo cat) "$0" ;;
            --smoke) dotest=1 dosmoke=1 ;;
            --test)  dotest=1 ;;
            *[A-Za-z:]*) process_stack | tester; model=$1 ;;
            [0-9]*) index+=( "$1" ) ;;
        esac
        shift
    done
    process_stack | tester 
fi
