#!/usr/bin/env python3
import argparse, fnmatch, json, os, requests, logging, sys, time, threading, signal
from http.server import HTTPServer, BaseHTTPRequestHandler

LOGLEVEL = os.getenv("LOGLEVEL", "INFO").upper()
logging.basicConfig(
    level=getattr(logging, LOGLEVEL, logging.INFO),
    format="%(message)s",
    stream=sys.stderr,
)
log = logging.getLogger("freeopenai")
from socketserver import ThreadingMixIn
from queue import Queue, Empty

CACHE_DIR = os.path.expanduser("~/.cache/free-ollama")
CACHE_FILE = os.path.join(CACHE_DIR, "free-ollama.json")
BAD_FILE = os.path.join(CACHE_DIR, "bad-hosts.txt")
GOOD_FILE = os.path.join(CACHE_DIR, "good-hosts.txt")
POOL_SIZE = int(os.environ.get("POOL_SIZE", "3"))
LAST_SUCCESS = {}
PORT = int(os.environ.get("PORT", "8080"))
TIMEOUT = 30

_bad_cache = None
_good_cache = None
_servers_cache = None


def ensure_cache():
    os.makedirs(CACHE_DIR, exist_ok=True)
    need = False
    if not os.path.exists(CACHE_FILE) or os.path.getsize(CACHE_FILE) == 0:
        need = True
    elif time.time() - os.path.getmtime(CACHE_FILE) > 86400:
        need = True
    if need:
        log.debug("Refreshing server cache...")
        script = os.path.join(os.path.dirname(__file__), "free-ollama")
        if not os.path.exists(script):
            script = "free-ollama"
        subprocess.run([script], capture_output=True, timeout=120)


def load_servers():
    global _servers_cache
    log.debug("Loading servers...")
    ensure_cache()
    if _servers_cache is None:
        with open(CACHE_FILE) as f:
            _servers_cache = json.load(f)
    return _servers_cache


def load_bad():
    global _bad_cache
    if _bad_cache is None:
        _bad_cache = set()
        if os.path.exists(BAD_FILE):
            with open(BAD_FILE) as f:
                for line in f:
                    if line.strip():
                        _bad_cache.add(line.strip())
    return _bad_cache


def add_bad(host, model):
    global _bad_cache
    with open(BAD_FILE, "a") as f:
        f.write(f"{host} {model}\n")
    if _bad_cache is not None:
        _bad_cache.add(f"{host} {model}")


def load_good():
    global _good_cache
    if _good_cache is None:
        _good_cache = set()
        if os.path.exists(GOOD_FILE):
            with open(GOOD_FILE) as f:
                for line in f:
                    if line.strip():
                        _good_cache.add(line.strip())
    return _good_cache


def add_good(host, model):
    key = f"{host} {model}"
    good = load_good()
    if key not in good:
        with open(GOOD_FILE, "a") as f:
            f.write(f"{key}\n")
        if _good_cache is not None:
            _good_cache.add(key)


def match_model(model_name, pattern):
    if any(c in pattern for c in "*?["):
        return fnmatch.fnmatch(model_name, f"*{pattern}*")
    return pattern in model_name


def find_servers(sub):
    servers = load_servers()
    bad = load_bad()
    good = load_good()
    matched = []
    for s in servers:
        models = s.get("models", [])
        ms = [m for m in models if match_model(m, sub)]
        if not ms:
            continue
        if any(":cloud" in m for m in models) and ":cloud" not in sub:
            continue
        host = s.get("server", "")
        key = f"{host} {sub}"
        if key in bad:
            continue
        is_good = key in good
        is_last = (host == LAST_SUCCESS.get(sub))
        matched.append((s.get("tps", 0), -2 if is_last else (-1 if is_good else 0), host, ms))
    matched.sort(key=lambda x: (x[1], x[0]))
    return matched


def all_models():
    servers = load_servers()
    seen = {}
    out = []
    for s in servers:
        for m in s.get("models", []):
            if ":cloud" in m:
                continue
            if m not in seen:
                seen[m] = {'id': m, 'count': 1}
            else:
                seen[m]['count'] += 1
    return list(seen.values())


def to_ollama(body):
    msg = body.get("messages", [])
    opts = {}
    if "temperature" in body:
        opts["temperature"] = body["temperature"]
    if "max_tokens" in body:
        opts["num_predict"] = body["max_tokens"]
    if "top_p" in body:
        opts["top_p"] = body["top_p"]
    return {"model": body.get("model", ""), "messages": msg, "options": opts}


def to_openai(resp, model):
    return {
        "id": f"chatcmpl-{int(time.time())}",
        "object": "chat.completion",
        "created": int(time.time()),
        "model": model,
        "choices": [{
            "index": 0,
            "message": {
                "role": "assistant",
                "content": resp.get("message", {}).get("content", ""),
            },
            "finish_reason": "stop",
        }],
        "usage": {
            "prompt_tokens": resp.get("prompt_eval_count", 0),
            "completion_tokens": resp.get("eval_count", 0),
            "total_tokens": resp.get("prompt_eval_count", 0) + resp.get("eval_count", 0),
        },
    }


def err_obj(msg, code=None):
    e = {"message": msg}
    if code:
        e["code"] = code
    return {"error": e}


def sse_chunk(model, content, done=False):
    return {
        "id": f"chatcmpl-{int(time.time())}",
        "object": "chat.completion.chunk",
        "created": int(time.time()),
        "model": model,
        "choices": [{
            "index": 0,
            "delta": {} if not content else {"content": content},
            "finish_reason": "stop" if done else None,
        }],
    }


def sse_str(obj):
    return f"data: {json.dumps(obj)}\n\n"


def parse_json(data):
    s = data.decode().strip()
    try:
        return json.loads(s)
    except json.JSONDecodeError:
        pass
    try:
        dec = json.JSONDecoder()
        obj, _ = dec.raw_decode(s)
        return obj
    except Exception:
        return None


def try_host(full_model, host, payload, q, done):
    tag = f"{host} {full_model}"
    if done.is_set():
        return
    result = [None]
    exc = [None]

    def make_request():
        try:
            result[0] = requests.post(
                f"{host}/api/chat",
                json=payload,
                timeout=TIMEOUT,
            )
        except Exception as e:
            exc[0] = e

    t = threading.Thread(target=make_request)
    t.start()
    t.join(timeout=TIMEOUT + 1)

    if done.is_set():
        log.debug(f"  └─ {tag}  (killed)")
        return

    if exc[0]:
        log.debug(f"  ✗ {tag}  (exception: {exc[0]})")
        q.put(("conn", host))
        return

    if result[0] is None:
        log.debug(f"  ✗ {tag}  (timeout)")
        q.put(("conn", host))
        return

    if result[0].status_code != 200:
        log.debug(f"  ✗ {tag}  (status {result[0].status_code})")
        q.put(("conn", host))
        return

    out = result[0].text
    if not out.strip():
        log.debug(f"  ✗ {tag}  (empty response)")
        q.put(("conn", host))
        return

    resp = parse_json(out.encode())
    if not isinstance(resp, dict):
        log.debug(f"  ✗ {tag}  (bad response: {out[:120]})")
        q.put(("conn", host))
        return

    if "error" in resp:
        log.debug(f"  ✗ {tag}  (error: {resp['error']})")
        q.put(("serv", host, resp["error"]))
        return

    if "choices" in resp and "message" not in resp:
        choices = resp.get("choices", [])
        if choices:
            msg = choices[0].get("message", {})
            resp = {"message": msg, "done": True}

    log.debug(f"  ✓ {tag}")
    q.put(("ok", host, resp))


def fan_out(sub, servers, payload):
    q = Queue()
    done = threading.Event()
    serv_errors = []
    for _, _, host, ms in servers:
        full = ms[0]
        p = dict(payload, model=full)
        t = threading.Thread(target=try_host, args=(full, host, p, q, done))
        t.start()
    pairs = [f"{h} {m[0]}" for (_, _, h, m) in servers]
    log.debug(f"  trying {sub} on {', '.join(pairs)}")
    remaining = len(servers)
    while remaining > 0:
        try:
            result = q.get(timeout=TIMEOUT + 5)
        except Empty:
            break
        remaining -= 1
        tag = result[0]
        if tag == "ok":
            done.set()
            LAST_SUCCESS[sub] = result[1]
            add_good(result[1], sub)
            return result[1], result[2], serv_errors
        if tag == "serv":
            serv_errors.append(result[1])
    done.set()
    return None, None, serv_errors


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/v1/models":
            models = all_models()
            self.send_json({
                "object": "list",
                "data": models
            })
        else:
            self.send_json(err_obj("not found"), 404)

    def do_POST(self):
        if self.path != "/v1/chat/completions":
            self.send_json(err_obj("not found"), 404)
            return
        length = int(self.headers.get("Content-Length", 0))
        try:
            body = json.loads(self.rfile.read(length))
        except json.JSONDecodeError:
            self.send_json(err_obj("invalid JSON"), 400)
            return
        model = body.get("model", "")
        if not model:
            self.send_json(err_obj("model is required", "missing_model"), 400)
            return
        do_stream = body.get("stream", False)
        opayload = to_ollama(body)
        log.debug(f"Request: model={model}, stream={do_stream}")

        last_host = LAST_SUCCESS.get(model)
        log.debug(f"Last successful for {model}: {last_host}")
        if last_host:
            servers = find_servers(model)
            log.debug(f"Found {len(servers)} servers for {model}")
            matched = [s for s in servers if s[2] == last_host]
            log.debug(f"Matched last successful: {len(matched)} servers")
            if matched:
                log.debug(f"  trying last successful: {last_host}")
                if do_stream:
                    self._try_stream(model, matched, opayload)
                    return
                else:
                    result = self._try_one(last_host, model, matched[0][3][0], opayload)
                    if result:
                        self.send_json(result, 200)
                        return

        servers = find_servers(model)
        if not servers:
            self.send_json(err_obj(f"no available servers for '{model}'", "model_not_found"), 404)
            return

        if do_stream:
            self._handle_stream(model, servers, opayload)
            return

        off = 0
        while off < len(servers):
            batch = servers[off:off + POOL_SIZE]
            host, data, serv_errors = fan_out(model, batch, dict(opayload, stream=False))
            for h in serv_errors:
                log.debug(f"  └─ added {h} to bad hosts")
                add_bad(h, model)
            if host is not None:
                self.send_json(to_openai(data, model))
                return
            off += POOL_SIZE
            if off < len(servers):
                log.debug(f"  retrying with next {POOL_SIZE} servers")
        log.debug("  ✗ all servers failed")
        self.send_json(err_obj("all servers failed"), 502)

    def _try_one(self, host, model, full_model, opayload):
        tag = f"{host} {full_model}"
        payload = dict(opayload, model=full_model, stream=False)
        try:
            resp = requests.post(f"{host}/api/chat", json=payload, timeout=TIMEOUT)
        except Exception as e:
            log.debug(f"  ✗ {tag}  (exception: {e})")
            return None

        if resp.status_code != 200:
            log.debug(f"  ✗ {tag}  (status {resp.status_code})")
            return None

        data = resp.json()
        if "error" in data:
            log.debug(f"  ✗ {tag}  (error: {data['error']})")
            return None

        log.debug(f"  ✓ {tag}")
        LAST_SUCCESS[model] = host
        add_good(host, model)
        return to_openai(data, model)

    def _try_stream(self, model, servers, opayload):
        _, _, host, ms = servers[0]
        full = ms[0]
        tag = f"{host} {full}"
        payload = dict(opayload, model=full, stream=True)

        try:
            resp = requests.post(f"{host}/api/chat", json=payload, timeout=TIMEOUT, stream=True)
        except Exception as e:
            log.debug(f"  ✗ {tag}  (exception: {e})")
            return None

        if resp.status_code != 200:
            log.debug(f"  ✗ {tag}  (status {resp.status_code})")
            return None

        lines_iter = resp.iter_lines()
        first_line = None
        for line in lines_iter:
            if not line:
                continue
            first_line = line
            break

        if not first_line:
            log.debug(f"  ✗ {tag}  (empty response)")
            return None

        try:
            first = json.loads(first_line)
        except json.JSONDecodeError:
            log.debug(f"  ✗ {tag}  (bad response)")
            return None

        if "error" in first:
            log.debug(f"  ✗ {tag}  (error: {first['error']})")
            return None

        log.debug(f"  ✓ {tag}")
        LAST_SUCCESS[model] = host
        add_good(host, model)

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        self.wfile.flush()

        self.wfile.write(sse_str(sse_chunk(full, first.get("message", {}).get("content", ""))).encode())
        self.wfile.flush()

        for line in lines_iter:
            if not line:
                continue
            obj = json.loads(line)
            content = obj.get("message", {}).get("content", "")
            try:
                if content:
                    self.wfile.write(sse_str(sse_chunk(full, content)).encode())
                if obj.get("done"):
                    self.wfile.write(sse_str(sse_chunk(full, "", done=True)).encode())
                    self.wfile.write(b"data: [DONE]\n\n")
                    self.wfile.flush()
                    return True
            except (BrokenPipeError, ConnectionResetError, OSError):
                log.debug("Client disconnected during stream")
                return None

        return True

    def _pick_winner(self, procs):
        q = Queue()

        def check(idx, proc, host, full):
            for raw in proc.stdout:
                line = raw.decode().strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if "error" in obj:
                    log.debug(f"  ✗ {host}  (error: {obj['error']})")
                    return
                q.put((idx, host, full, obj))
                return

        for idx, (proc, host, full) in enumerate(procs):
            t = threading.Thread(target=check, args=(idx, proc, host, full))
            t.daemon = True
            t.start()

        try:
            idx, host, full, obj = q.get(timeout=TIMEOUT)
            for j, (p, _, _) in enumerate(procs):
                if j != idx:
                    p.kill()
            log.debug(f"  ✓ {host} {full}")
            return idx, host, full, obj
        except Empty:
            for p, _, _ in procs:
                p.kill()
            return None, None, None, None

    def _handle_stream(self, model, servers, opayload):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "keep-alive")
        self.end_headers()
        self.wfile.flush()

        server_iter = iter(servers)
        active = {}
        result_queue = Queue()
        done_event = threading.Event()

        def spawn_one(idx):
            try:
                _, _, host, ms = next(server_iter)
            except StopIteration:
                return None
            full = ms[0]
            p = dict(opayload, model=full, stream=True)

            def request_in_thread(resp_holder, err_holder):
                try:
                    resp_holder[0] = requests.post(
                        f"{host}/api/chat",
                        json=p,
                        timeout=TIMEOUT,
                        stream=True,
                    )
                except Exception as e:
                    err_holder[0] = e

            resp = [None]
            err = [None]
            t = threading.Thread(target=request_in_thread, args=(resp, err))
            t.start()
            t.join(timeout=TIMEOUT + 1)

            if err[0]:
                return None

            active[resp[0]] = (host, full)
            return resp[0]

        for i in range(POOL_SIZE):
            if spawn_one(i) is None:
                break

        def monitor_resp(resp):
            try:
                for line in resp.iter_lines():
                    if done_event.is_set():
                        return
                    if not line:
                        continue
                    try:
                        obj = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if "error" in obj:
                        log.debug(f"  ✗ {active[resp][0]}  (error: {obj['error']})")
                        result_queue.put(("fail", resp))
                        return
                    result_queue.put(("ok", resp, obj))
                    return
                result_queue.put(("fail", resp))
            except Exception:
                result_queue.put(("fail", resp))

        for resp in list(active.keys()):
            t = threading.Thread(target=monitor_resp, args=(resp,))
            t.daemon = True
            t.start()

        while True:
            try:
                result = result_queue.get(timeout=TIMEOUT)
            except Empty:
                for resp in active:
                    log.debug(f"Closing connection to {active[resp][0]}")
                    resp.close()
                log.debug("All servers failed")
                try:
                    self.wfile.write(sse_str({"error": "all servers failed"}).encode())
                    self.wfile.write(b"data: [DONE]\n\n")
                except (BrokenPipeError, ConnectionResetError, OSError):
                    log.debug("Client disconnected")
                return
                return

            tag = result[0]
            if tag == "ok":
                done_event.set()
                winning_resp = result[1]
                first = result[2]
                win_host, win_full = active[winning_resp]
                LAST_SUCCESS[model] = win_host
                add_good(win_host, model)

                for resp in active:
                    if resp != winning_resp:
                        log.debug(f"Closing connection to {active[resp][0]}")
                        resp.close()

                log.debug(f"Using {win_host} for {model}")
                try:
                    self.wfile.write(sse_str(sse_chunk(win_full, first.get("message", {}).get("content", ""))).encode())
                except (BrokenPipeError, ConnectionResetError, OSError):
                    log.debug("Client disconnected")
                    winning_resp.close()
                    return

                for line in winning_resp.iter_lines():
                    if not line:
                        continue
                    obj = json.loads(line)
                    content = obj.get("message", {}).get("content", "")
                    try:
                        if content:
                            self.wfile.write(sse_str(sse_chunk(win_full, content)).encode())
                        if obj.get("done"):
                            self.wfile.write(sse_str(sse_chunk(win_full, "", done=True)).encode())
                            self.wfile.write(b"data: [DONE]\n\n")
                            self.wfile.flush()
                            return
                    except (BrokenPipeError, ConnectionResetError, OSError):
                        log.debug("Client disconnected during stream")
                        winning_resp.close()
                        return
                return

            if tag == "fail":
                failed_resp = result[1]
                if failed_resp in active:
                    failed_host, failed_full = active[failed_resp]
                    log.debug(f"  ✗ {failed_host}  (failed)")
                    log.debug(f"Closing connection to {failed_host}")
                    failed_resp.close()
                    del active[failed_resp]

                    new_resp = spawn_one(len(active))
                    if new_resp:
                        log.debug(f"Starting new request to {active[new_resp][0]}")
                        t = threading.Thread(target=monitor_resp, args=(new_resp,))
                        t.daemon = True
                        t.start()

                if not active:
                    try:
                        self.wfile.write(sse_str({"error": "all servers failed"}).encode())
                        self.wfile.write(b"data: [DONE]\n\n")
                    except (BrokenPipeError, ConnectionResetError, OSError):
                        log.debug("Client disconnected")
                    return

    def send_json(self, data, status=200):
        body = json.dumps(data)
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body.encode())))
        self.end_headers()
        self.wfile.write(body.encode())

    def log_message(self, fmt, *args):
        log.debug(f"[{self.log_date_time_string()}] {self.client_address[0]} - {fmt % args}")

    def safe_write(self, data):
        try:
            self.wfile.write(data)
            self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            log.debug("Client disconnected")
            raise


class PoolServer(ThreadingMixIn, HTTPServer):
    allow_reuse_address = True
    daemon_threads = True


def main():
    global TIMEOUT
    parser = argparse.ArgumentParser(description="freeopenai - OpenAI-compatible proxy for free Ollama servers")
    parser.add_argument("--port", "-p", type=int, default=PORT, help=f"port to listen on (default: {PORT})")
    parser.add_argument("--timeout", "-t", type=int, default=30, help="request timeout in seconds (default: 30)")
    args = parser.parse_args()
    TIMEOUT = args.timeout

    srv = PoolServer(("", args.port), Handler)
    log.debug(f"Starting freeopenai on port {args.port}, POOL_SIZE={POOL_SIZE}, TIMEOUT={TIMEOUT}")
    print(f"freeopenai :{args.port}  POOL_SIZE={POOL_SIZE}  TIMEOUT={TIMEOUT}", file=sys.stderr)
    def stop(sig, frm):
        log.debug("Shutting down")
        print("\nbye", file=sys.stderr)
        raise KeyboardInterrupt
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        srv.shutdown()


if __name__ == "__main__":
    main()
