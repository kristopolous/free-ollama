      "needs": [
        "KSampler",
        "VAEDecode",
        "CLIPTextEncode",
        "CLIPLoader",
        "VAELoader",
        "EmptyHunyuanLatentVideo"
      ],
      "length": 81,
      "steps": 20,
      "cfg": 1.0,
      "shift": 5.0,
      "fps": 16,
      "frame_step": 4,
      "px": 409600,
      "dim_step": 32,
      "moe": true
    }
  ],
  "tts_exclude": [
    "(?i)voice.?clone",
    "(?i)voice.?convert",
    "(?i)clone|convert|train|finetune",
    "(?i)^(load|save|preview|play)",
    "(?i)loader$|saver$|batch|concat|combine|merge|split|trim",
    "(?i)stt|speech.?to.?text|transcri|asr",
    "(?i)upscal|denois|separat"
  ]
