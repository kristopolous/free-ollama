  "music": [
    {
      "name": "AceStep1.5",
      "encode": [
        "^TextEncodeAceStepAudio1\\.5$"
      ],
      "latent": [
        "^EmptyAceStep1\\.5LatentAudio$"
      ],
      "style": "tags",
      "lyrics": "lyrics",
      "seconds": "seconds",
      "enc_seconds": "duration",
      "ckpt": "(?i)ace.?step",
      "note": "1.5 carries the length on the encode node as `duration` AND on the latent as `seconds`; they have to agree or the sampler and the conditioning disagree about how long the song is."
    },
    {
      "name": "AceStep",
      "encode": [
        "^TextEncodeAceStepAudio$"
      ],
      "latent": [
        "^EmptyAceStepLatentAudio$"
      ],
      "style": "tags",
      "lyrics": "lyrics",
      "seconds": "seconds",
      "ckpt": "(?i)ace.?step",
      "note": "Anchored so it cannot claim the 1.5 nodes, which take different inputs."
    },
    {
      "name": "MiniMaxMusic3",
      "encode": [
        "^MiniMaxMusic3TextEncode$"
      ],
      "latent": [
        "^EmptyMiniMaxMusic3LatentAudio$"
      ],
      "style": "caption",
      "lyrics": "lyrics",
      "seconds": "seconds",
      "enc_seconds": "max_duration",
      "unet": "(?i)minimax.?music3.*dit",
      "clip": "(?i)minimax.?music3.*text.?encoder",
      "clip_type": "(?i)minimax|music",
      "vae": "(?i)minimax.?music3.*dav",
      "ckpt": "(?i)minimax.?music",
      "note": "Ships as three separate files (diffusion_models/, text_encoders/, vae/) rather than one checkpoint, so it needs the loader trio. Class names verified against the published node reference; the CLIPLoader type value is resolved from the host's own enum."
    },
    {
      "name": "Generic",
      "encode": [
        "(?i)^textencode.*(?:music|song|audio)"
      ],
      "latent": [
        "(?i)^empty.*(?:music|song|audio).*latent"
      ],
      "style": null,
      "lyrics": null,
      "seconds": null,
      "ckpt": "(?i)music|song"
    }
  ],
  "edit": [
    {
      "name": "QwenImageEditPlus",
      "style": "encode",
      "patterns": [
        "^TextEncodeQwenImageEditPlus$"
      ],
      "images": [
        "image1",
        "image2",
        "image3"
      ],
      "model": "(?i)qwen.*image.*edit",
      "clip": [
        "(?i)qwen[-_. ]?2[-_. ]?5[-_. ]?vl",
        "(?i)qwen.*vl"
      ],
      "vae": [
        "(?i)qwen[-_. ]?image[-_. ]?vae",
        "(?i)qwen.*vae"
      ],
      "clip_type": "qwen_image",
      "cfg": 2.5,
      "steps": 20
    },
    {
      "name": "QwenImageEdit",
      "style": "encode",
      "patterns": [
        "^TextEncodeQwenImageEdit$"
      ],
      "images": [
        "image"
      ],
      "model": "(?i)qwen.*image.*edit",
      "clip": [
        "(?i)qwen[-_. ]?2[-_. ]?5[-_. ]?vl",
        "(?i)qwen.*vl"
      ],
      "vae": [
        "(?i)qwen[-_. ]?image[-_. ]?vae",
        "(?i)qwen.*vae"
      ],
      "clip_type": "qwen_image",
      "cfg": 2.5,
      "steps": 20
    },
    {
      "name": "ZImage",
      "style": "encode",
      "patterns": [
        "^TextEncodeZImageOmni$"
      ],
      "images": [
        "image1",
        "image2",
        "image3"
      ],
      "model": "(?i)z[-_. ]?image",
      "clip": [
        "(?i)qwen[-_. ]?2[-_. ]?5[-_. ]?vl",
        "(?i)qwen.*vl"
      ],
      "clip_type": "qwen_image",
      "vae": [
        "(?i)qwen[-_. ]?image[-_. ]?vae",
        "(?i)qwen.*vae"
      ],
      "cfg": 1.0,
      "steps": 8,
      "note": "Z-Image (Tongyi). Encode-style via TextEncodeZImageOmni; the image slots are optional, so with zero references it is text-to-image. Clip is Qwen2.5-VL loaded as type 'qwen_image' (inferred — the enum has no z-image type; same encoder backbone as Qwen-Image); VAE is Qwen-Image's. Verified feasible against a real z-image host's /object_info."
    },
    {
      "name": "Flux2Klein",
      "style": "reference",
      "patterns": [
        "^ReferenceLatent$"
      ],
      "scale": "FluxKontextImageScale",
      "guidance_node": "FluxGuidance",
      "guidance": 2.5,
      "model": "(?i)klein",
      "clip": "(?i)qwen[-_. ]?3",
      "vae": "(?i)flux[-_.]?2[-_.]?vae",
      "clip_type": "flux2",
      "cfg": 1.0,
      "steps": 20,
      "note": "FLUX.2 klein uses Qwen3, not Mistral. Verified against the FLUX.2 klein model cards and ComfyUI's klein tutorial."
    },
    {
      "name": "Flux2",
      "style": "reference",
      "patterns": [
        "^ReferenceLatent$"
      ],
      "scale": "FluxKontextImageScale",
      "guidance_node": "FluxGuidance",
      "guidance": 2.5,
      "model": "(?i)flux[-_. ]?2(?!.*klein)",
      "clip": "(?i)mistral.*flux2|flux2.*mistral|mistral",
      "vae": "(?i)flux[-_.]?2[-_.]?vae",
      "clip_type": "flux2",
      "cfg": 1.0,
      "steps": 20,
      "note": "Non-klein Flux.2 uses Mistral-3 small. klein is excluded via lookahead so a klein+Mistral host is rejected at planning, not after a multi-minute render."
    },
    {
      "name": "FluxKontext",
      "style": "reference",
      "patterns": [
        "^ReferenceLatent$"
      ],
      "scale": "FluxKontextImageScale",
      "guidance_node": "FluxGuidance",
      "guidance": 2.5,
      "model": "(?i)kontext",
      "clip": "(?i)clip_l",
      "clip2": "(?i)t5xxl",
      "vae": "(?i)(^|[/\\\\])ae\\.",
      "clip_type": "flux",
      "cfg": 1.0,
      "steps": 20
    }
  ],
